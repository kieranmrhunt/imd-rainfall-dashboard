SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=UTC

# One daily update after the usual IMD daily-data publication window.
30 17 * * * /usr/bin/flock -n "$HOME/mitre/imd-rainfall-dashboard/recent-update.lock" "$HOME/mitre/imd-rainfall-dashboard/repo/scripts/run_recent_update.sh" >> "$HOME/mitre/imd-rainfall-dashboard/logs/recent-update.log" 2>&1
